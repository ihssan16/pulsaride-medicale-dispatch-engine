{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsaride.local/events/request.triaged.v1.payload.schema.json",
  "title": "request.triaged.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "urgencyScore",
    "specialtyHint",
    "confidence",
    "modelVersion",
    "ruleVersion",
    "requiresReview"
  ],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "urgencyScore": { "type": "integer", "minimum": 0, "maximum": 3 },
    "specialtyHint": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "modelVersion": { "type": "string", "minLength": 1 },
    "ruleVersion": { "type": "string", "minLength": 1 },
    "requiresReview": { "type": "boolean" },
    "triggeredRules": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
