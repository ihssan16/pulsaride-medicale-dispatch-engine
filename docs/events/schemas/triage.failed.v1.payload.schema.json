{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsaride.local/events/triage.failed.v1.payload.schema.json",
  "title": "triage.failed.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "failureCode", "fallbackUrgencyScore", "fallbackSpecialtyHint", "requiresReview"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "failureCode": {
      "type": "string",
      "enum": ["AI_TIMEOUT", "AI_UNAVAILABLE", "INVALID_MODEL_OUTPUT", "PIPELINE_ERROR"]
    },
    "fallbackUrgencyScore": { "type": "integer", "minimum": 0, "maximum": 3 },
    "fallbackSpecialtyHint": { "type": "string", "minLength": 1 },
    "requiresReview": { "type": "boolean" },
    "errorMessage": { "type": "string" }
  }
}
