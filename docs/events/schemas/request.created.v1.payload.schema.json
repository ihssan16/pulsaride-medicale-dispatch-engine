{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulsaride.local/events/request.created.v1.payload.schema.json",
  "title": "request.created.v1 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "patientId", "freeText", "specialtyHint", "initialUrgencyScore", "createdAt"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1 },
    "patientId": { "type": "string", "minLength": 1 },
    "freeText": { "type": "string", "minLength": 1 },
    "specialtyHint": { "type": "string", "minLength": 1 },
    "initialUrgencyScore": { "type": "integer", "minimum": 0, "maximum": 3 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
