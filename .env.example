# Pulsaride local environment template.
# Copy to .env for local runs. Never commit .env.

# Core API mode:
# - mock: local deterministic triage rules
# - external: call Darija Health NLP through AI_EXTERNAL_URL
AI_MODE=mock
AI_EXTERNAL_URL=http://darija-ai:8000
AI_FALLBACK_ENABLED=true

# Optional local paths for the Darija Health NLP sidecar.
DARIJA_HEALTH_NLP_DIR=../darija-health-nlp
DARIJA_MODEL_DIR=../darija-health-nlp/models

# Optional OpenAI experimentation key.
# Important: use a rotated key here, not a key pasted in chat or docs.
OPENAI_API_KEY=replace-me-after-rotation
